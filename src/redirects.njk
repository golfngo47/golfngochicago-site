---
permalink: "_redirects"
eleventyExcludeFromCollections: true
---
/how-it-works                               /how-it-works.html                               301
/what-we-offer                              /what-we-offer.html                              301
/event-list                                 /event-list.html                                 301
/locations                                  /locations.html                                  301

# Event pages — generated from src/_data/events.json, one rule per event so a
# new event type can never be added without also getting a redirect rule.
{%- for e in events %}
{%- if e.status == "draft" %}
/golf-simulator-{{ e.slug }}-chicago        /404.html                                        404
/golf-simulator-{{ e.slug }}-chicago.html   /404.html                                        404
{%- else %}
/golf-simulator-{{ e.slug }}-chicago        /golf-simulator-{{ e.slug }}-chicago.html        301
{%- endif %}
{%- endfor %}

# Location pages — generated from src/_data/cities.json, one rule per city
# (fixes the 10 cities that were previously missing this rule).
{%- for c in cities %}
/golf-simulator-rental-{{ c.slug }}         /golf-simulator-rental-{{ c.slug }}.html         301
{%- endfor %}

