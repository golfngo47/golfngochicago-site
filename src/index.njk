<script>
  (function() {
    var POPUP_KEY    = 'gng_popup_dismissed';
    var BOOKED_KEY   = 'gng_booked';
    var DISMISS_TTL  = 24 * 60 * 60 * 1000; // 24 hours in ms
    var DELAY_MS     = 15000;                // 15 seconds

    function shouldShow() {
      if (localStorage.getItem(BOOKED_KEY)) return false;
      var dismissed = localStorage.getItem(POPUP_KEY);
      if (dismissed && (Date.now() - parseInt(dismissed, 10)) < DISMISS_TTL) return false;
      return true;
    }

    function showPopup() {
      var popup   = document.getElementById('gng-popup');
      var overlay = document.getElementById('gng-popup-overlay');
      if (!popup) return;
      overlay.style.display = 'block';
      popup.style.display   = 'block';
      // Force reflow on both so CSS transitions fire correctly
      void overlay.offsetWidth;
      void popup.offsetWidth;
      popup.classList.add('gng-popup-visible');
      overlay.classList.add('gng-popup-visible');
    }

    function dismissPopup() {
      var popup   = document.getElementById('gng-popup');
      var overlay = document.getElementById('gng-popup-overlay');
      if (!popup) return;
      popup.classList.remove('gng-popup-visible');
      overlay.classList.remove('gng-popup-visible');
      localStorage.setItem(POPUP_KEY, String(Date.now()));
      setTimeout(function() {
        popup.style.display = 'none';
        overlay.style.display = 'none';
      }, 450);
    }

    // Mark booked when CTA clicked
    var ctaBtn = document.getElementById('gng-popup-cta');
    if (ctaBtn) {
      ctaBtn.addEventListener('click', function() {
        localStorage.setItem(BOOKED_KEY, '1');
        dismissPopup();
      });
    }

    // Also flag Book Now buttons in the main nav/page
    document.querySelectorAll('.nav-book, .btn-book, .mobile-nav-book').forEach(function(el) {
      el.addEventListener('click', function() {
        localStorage.setItem(BOOKED_KEY, '1');
      });
    });

    document.getElementById('gng-popup-close').addEventListener('click', dismissPopup);
    document.getElementById('gng-popup-overlay').addEventListener('click', dismissPopup);

    if (shouldShow()) {
      setTimeout(showPopup, DELAY_MS);
    }
  })();

  // NAV: mobile service areas accordion
  var areasToggle  = document.getElementById('areasToggle');
  var areasSubList = document.getElementById('areasSubList');
  var areasArrow   = document.getElementById('areasArrow');
  if (areasToggle && areasSubList) {
    areasToggle.addEventListener('click', function () {
      var isOpen = areasSubList.classList.toggle('open');
      if (areasArrow) areasArrow.classList.toggle('open', isOpen);
      areasToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
