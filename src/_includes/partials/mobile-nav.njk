{%- set featuredCitySlugs = ["naperville","schaumburg","evanston","oak-brook","hinsdale","orland-park","northbrook","glenview"] -%}
<div class="mobile-nav" id="mobileNav">
  <ul class="mobile-nav-list">
    <li><a href="/" class="mobile-nav-close-link">Home</a></li>
    <li><button class="mobile-accordion-toggle" id="eventsToggle">Events &#9662;</button>
      <ul class="mobile-sub-list" id="eventsSubList">
        {%- for e in events %}{% if e.status == "live" %}
        <li><a href="/golf-simulator-{{ e.slug }}-chicago.html" class="mobile-nav-close-link">{{ e.name }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </li>
    <li><a href="/how-it-works.html" class="mobile-nav-close-link">How It Works</a></li>
    <li><a href="/what-we-offer.html" class="mobile-nav-close-link">What We Offer</a></li>
    <li><a href="/#gallery" class="mobile-nav-close-link">Gallery</a></li>
    <li><button class="mobile-accordion-toggle" id="areasToggle" type="button" aria-expanded="false" aria-controls="areasSubList">Service Areas <span class="mobile-accordion-arrow" id="areasArrow">&#9662;</span></button>
      <ul class="mobile-sub-list" id="areasSubList">
        {%- for slug in featuredCitySlugs %}{% for c in cities %}{% if c.slug == slug %}
        <li><a href="/golf-simulator-rental-{{ c.slug }}.html" class="mobile-nav-close-link">{{ c.name }}</a></li>
        {%- endif %}{% endfor %}{% endfor %}
        <li><a href="/locations.html" class="mobile-nav-close-link">View All Locations →</a></li>
      </ul>
    </li>
    <li><a href="/#faq" class="mobile-nav-close-link">FAQ</a></li>
    <li><a href="/blog.html" class="mobile-nav-close-link">Blog</a></li>
    <li><a href="/#contact" class="mobile-nav-close-link">Contact</a></li>
  </ul>
  <div class="mobile-nav-bottom">
    <a href="{{ site.jotformUrl }}" target="_blank" rel="noopener noreferrer" class="mobile-nav-book">Book Now</a>
    <a href="{{ site.phoneHref }}" class="mobile-nav-phone">{{ site.phone }}</a>
    <div class="mobile-nav-socials">
      <a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="{{ site.social.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
        <svg width="17" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
      </a>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => { navbar.classList.toggle('scrolled', window.scrollY > 50); }, { passive: true });
  const hamburger = document.getElementById('hamburger');
  const mobileNav = document.getElementById('mobileNav');
  hamburger.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    mobileNav.classList.toggle('open');
    document.body.style.overflow = mobileNav.classList.contains('open') ? 'hidden' : '';
  });
  document.querySelectorAll('.mobile-nav-close-link').forEach(link => {
    link.addEventListener('click', () => {
      hamburger.classList.remove('open');
      mobileNav.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
  const eventsToggle = document.getElementById('eventsToggle');
  const eventsSubList = document.getElementById('eventsSubList');
  if (eventsToggle) eventsToggle.addEventListener('click', () => { eventsSubList.classList.toggle('open'); });
  const areasToggle = document.getElementById('areasToggle');
  const areasSubList = document.getElementById('areasSubList');
  const areasArrow = document.getElementById('areasArrow');
  if (areasToggle && areasSubList) {
    areasToggle.addEventListener('click', function () {
      const isOpen = areasSubList.classList.toggle('open');
      if (areasArrow) areasArrow.classList.toggle('open', isOpen);
      areasToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', function () {
      const item = this.closest('.faq-item');
      item.classList.toggle('open');
      this.setAttribute('aria-expanded', String(item.classList.contains('open')));
    });
  });
  if (!window.matchMedia('(prefers-reduced-motion:reduce)').matches) {
    const ro = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); ro.unobserve(e.target); } });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach(el => el.classList.add('is-visible'));
  }
});
</script>
