<footer id="contact">
  <div class="footer-main">
    <div>
      <a href="/" class="footer-logo"><img src="/images/main_logo_trans.svg" alt="Golf n Go Chicago" loading="lazy"/></a>
      <p class="footer-tagline">Bring the Course to You</p>
      <p class="footer-desc">Chicago's premier mobile golf simulator rental — delivering a world-class experience to your event anywhere in Chicagoland.</p>
      <div class="footer-socials">
        <a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer" class="footer-social-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>@golfngochicago</a>
        <a href="{{ site.social.tiktok }}" target="_blank" rel="noopener noreferrer" class="footer-social-link"><svg width="14" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>@golfngochicago</a>
        <a href="{{ site.social.googleReviews }}" target="_blank" rel="noopener noreferrer" class="footer-social-link">⭐ Google Reviews</a>
      </div>
    </div>
    <div>
      <p class="footer-col-heading">Quick Links</p>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/#events">Events</a></li>
        <li><a href="/how-it-works.html">How It Works</a></li>
        <li><a href="/locations.html">Locations</a></li>
        <li><a href="/blog.html">Blog</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-col-heading">Event Types</p>
      <ul class="footer-links">
        {%- for e in events %}{% if e.status == "live" %}
        <li><a href="/golf-simulator-{{ e.slug }}-chicago.html">{{ e.name }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-copyright">&copy; {{ year }} {{ site.name }}. All rights reserved. | {{ site.baseAddress.city }}, {{ site.baseAddress.state }} | golfngochicago.com</p>
      <a href="{{ site.phoneHref }}" class="footer-bottom-phone">{{ site.phone }}</a>
      <ul class="footer-bottom-links"><li><a href="/sitemap.xml">Sitemap</a></li><li><a href="/#faq">FAQ</a></li><li><a href="/#contact">Contact</a></li></ul>
    </div>
  </div>
</footer>
